# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit keys.

# OpenAI key: used for fit scoring (and for speech-to-text if STT=openai).
OPENAI_API_KEY=

# Optional: OpenAI model for scoring. Leave empty for the default.
OPENAI_MODEL=

# Speech-to-text: "openai" (default when a key is set; best with names)
# or "whisper" (local whisper.cpp, free and offline, often mishears names).
STT=openai

# Treg (treg.to) token: company facts for setup, and checking work roles.
TREG_API_KEY=

# Optional: Notion internal integration secret (ntn_...). Saved leads go to a
# "Handshake leads" database, created under a page shared with the integration.
NOTION_TOKEN=

# Optional: HubSpot private app token (pat-...). When set, saved leads go to
# HubSpot instead of Notion: each person becomes a contact, each conversation
# a note. Create one under Settings > Integrations > Private Apps with the
# crm.objects.contacts.read and crm.objects.contacts.write scopes.
HUBSPOT_TOKEN=
