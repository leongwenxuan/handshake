{
  "name": "handshake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "backend": "node --watch backend/src/server.ts",
    "whisper": "whisper-server -m backend/models/ggml-base.en.bin --port 8178 -nt",
    "bench": "node backend/scripts/bench.ts",
    "fixtures": "sh backend/scripts/make-fixtures.sh"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
